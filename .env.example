# Game Theory - copy to `.env` and edit. Every value here has a working
# default, so an empty `.env` is a valid `.env` (docs/SPEC.md section 12).

# ---------------------------------------------------------------- app
ENV=dev
LOG_LEVEL=INFO
LOG_JSON=false

# ---------------------------------------------------------------- ports
# Only read by docker compose. Change BACKEND_PORT if something else already
# owns 8000 on your machine (IIS, Apache/XAMPP, another dev server).
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ---------------------------------------------------------------- simulation
SIM_SEED=1337
SIM_MAX_AGENTS=1000

# ---------------------------------------------------------------- llm
# `mock` is deterministic, free and needs nothing installed. Switch to
# `ollama` only after `ollama pull <model>` has finished (see README).
LLM_PROVIDER=mock
LLM_ENABLED=true
LLM_MAX_AGENTS=8
LLM_MAX_CONCURRENCY=1
LLM_MAX_CALLS_PER_MIN=30
LLM_MIN_INTERVAL_SIM_S=20
LLM_TIMEOUT_S=20
# off | reduced | full - what happens to LLM calls above 5x speed
LLM_HIGH_SPEED_POLICY=reduced

# Native Ollama on the host:            http://localhost:11434
# Backend in Docker, Ollama native:     http://host.docker.internal:11434
# Both in Docker (`--profile llm`):     http://ollama:11434
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
